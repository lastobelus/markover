{
  "name": "markover",
  "productName": "Markover",
  "version": "0.1.3",
  "description": "A tiny structured Markdown review tool for giving feedback to agent threads.",
  "main": "build/app/src/main.js",
  "bin": {
    "markover": "build/scripts/markover.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node build/scripts/copy-build-assets.js && node build/scripts/build-app.js",
    "build:icon:mac": "npm run build --silent && node build/scripts/build-macos-icon.js",
    "build:cli": "npm run build --silent && node build/scripts/build-cli.js",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "package:mac": "install-electron --no && npm run build:icon:mac && npm run notices:check:built && node build/scripts/package-macos.js --trust-mode=ad-hoc",
    "release:preflight": "npm run build --silent && node build/scripts/release-preflight.js",
    "markover": "npm run build --silent && node build/scripts/markover.js",
    "link-handler": "npm run build --silent && node build/scripts/link-handler.js",
    "setup:canonical": "npm run build --silent && node build/scripts/setup-canonical.js",
    "start": "npm run build --silent && node build/scripts/start.js",
    "dev": "node scripts/development-watch-bootstrap.js",
    "smoke:auth": "npm run build --silent && node build/scripts/smoke-auth.js",
    "smoke": "npm run build --silent && npm run smoke:built",
    "smoke:built": "node build/scripts/run-smoke.js",
    "smoke:packaged": "npm run build --silent && node build/scripts/smoke-packaged.js",
    "pretest": "install-electron --no",
    "test": "npm run build --silent && npm run test:built",
    "test:built": "node --test build/test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:app": "node build/scripts/verify-app-layout.js",
    "notices:generate": "npm run build --silent && node build/scripts/generate-third-party-notices.js",
    "notices:check": "npm run build --silent && npm run notices:check:built",
    "notices:check:built": "node build/scripts/generate-third-party-notices.js --check",
    "eval:annotation": "npm run build --silent && node build/scripts/annotation-interpretation-eval.js run",
    "eval:annotation:validate": "npm run build --silent && node build/scripts/annotation-interpretation-eval.js validate",
    "decision-gardener": "npm run build --silent && node build/scripts/decision-gardener-run.js",
    "check": "npm run lint && npm run typecheck && npm run notices:check",
    "ci:local": "npm run build --silent && npm run lint && npm run typecheck && npm run notices:check:built && npm run test:built && npm run smoke:built -- --timeout=10"
  },
  "author": "Michael Johnston (lastobelus)",
  "copyright": "Copyright © 2026 Michael Johnston (lastobelus)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "^2.6.0",
    "@electron/packager": "^20.0.4",
    "@eslint/js": "^10.0.1",
    "@pierre/diffs": "1.3.0-beta.10",
    "@pierre/trees": "1.0.0-beta.4",
    "@types/debug": "^4.1.13",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "43.2.0",
    "esbuild": "0.25.8",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.0.1",
    "markdown-it": "^14.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  }
}
