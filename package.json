{
  "name": "markover",
  "productName": "Markover",
  "version": "0.1.1",
  "description": "A tiny structured Markdown review tool for giving feedback to agent threads.",
  "main": "build/src/main.js",
  "bin": {
    "markover": "build/scripts/markover.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:vendor && tsc -p tsconfig.json && node build/scripts/copy-build-assets.js",
    "build:icon:mac": "npm run build --silent && node build/scripts/build-macos-icon.js",
    "build:cli": "npm run build --silent && node build/scripts/build-cli.js",
    "build:vendor": "esbuild src/pierre-diffs-entry.mts --bundle --format=iife --platform=browser --minify --log-level=warning --outfile=src/vendor/pierre-diffs.js && esbuild src/yaml-entry.mjs --bundle --format=iife --platform=browser --minify --log-level=warning --outfile=src/vendor/yaml.js",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "package:mac": "npm run build:icon:mac && npm run notices:check && node build/scripts/package-macos.js --trust-mode=ad-hoc",
    "postinstall": "npm run build:vendor",
    "release:preflight": "npm run build --silent && node build/scripts/release-preflight.js",
    "markover": "npm run build --silent && node build/scripts/markover.js",
    "start": "npm run build --silent && node build/scripts/start.js",
    "review": "npm run build --silent && node build/scripts/review.js",
    "review:open": "npm run build --silent && node build/scripts/open-review.js",
    "pretest": "install-electron --no",
    "test": "npm run build --silent && node --test build/test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "notices:generate": "npm run build --silent && node build/scripts/generate-third-party-notices.js",
    "notices:check": "npm run build --silent && node build/scripts/generate-third-party-notices.js --check",
    "check": "npm run lint && npm run typecheck && npm run notices:check"
  },
  "author": "lastobelus",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.6.0",
    "@electron/packager": "^20.0.4",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "43.2.0",
    "esbuild": "0.25.8",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.0-beta.10",
    "@pierre/trees": "1.0.0-beta.4",
    "markdown-it": "^14.3.0",
    "yaml": "^2.9.0"
  }
}
